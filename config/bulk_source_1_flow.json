{
  "directories": {
    "source_dirs": [
      "runtime/bulk_xml_test/source_1"
    ],
    "archive_dir": "runtime/bulk_xml_test/flow_1/archive",
    "staging_dir": "runtime/bulk_xml_test/flow_1/staging",
    "output_root": "runtime/bulk_xml_test/flow_1/output",
    "prepublish_dir": "runtime/bulk_xml_test/flow_1/prepublish",
    "quarantine_dir": "runtime/bulk_xml_test/flow_1/quarantine",
    "sqlite_path": "runtime/bulk_xml_test/flow_1/integration_run.sqlite3",
    "lock_file": "runtime/bulk_xml_test/flow_1/integration.lock"
  },
  "runtime": {
    "file_stability_seconds": 0,
    "archive_retention_days": 10,
    "no_overlap": true,
    "config_revision": 3
  },
  "rules": [
    {
      "rule_id": "source_1_invoice",
      "description": "Source 1 normal invoice documents from TLO1.",
      "target_path_template": "source_1/invoices/{yyyy}/{mm}/{invoice_number}.xml",
      "publish_mode": "replace",
      "conditions": {
        "all": [
          {
            "xpath": "/Envelope/Header/Sender/CompanyCode",
            "type": "str",
            "transform": "upper",
            "op": "eq",
            "value": "TLO1"
          },
          {
            "xpath": "/Envelope/Body/Documents/Document/Metadata/SourceDirectory",
            "type": "str",
            "op": "eq",
            "value": "source_1"
          },
          {
            "xpath": "/Envelope/Body/Documents/Document/Metadata/DocumentType",
            "type": "str",
            "transform": "upper",
            "op": "eq",
            "value": "INVOICE"
          },
          {
            "xpath": "/Envelope/Body/Documents/Document/Identifiers/InvoiceNumber",
            "type": "str",
            "op": "regex",
            "value": "^INV-\\d{6}$",
            "alias": "invoice_number"
          }
        ]
      }
    },
    {
      "rule_id": "source_1_credit_note",
      "description": "Source 1 credit note documents from TLO1.",
      "target_path_template": "source_1/credit_notes/{yyyy}/{mm}/{invoice_number}.xml",
      "publish_mode": "replace",
      "conditions": {
        "all": [
          {
            "xpath": "/Envelope/Header/Sender/CompanyCode",
            "type": "str",
            "transform": "upper",
            "op": "eq",
            "value": "TLO1"
          },
          {
            "xpath": "/Envelope/Body/Documents/Document/Metadata/SourceDirectory",
            "type": "str",
            "op": "eq",
            "value": "source_1"
          },
          {
            "xpath": "/Envelope/Body/Documents/Document/Metadata/DocumentType",
            "type": "str",
            "transform": "upper",
            "op": "eq",
            "value": "CREDIT_NOTE"
          },
          {
            "xpath": "/Envelope/Body/Documents/Document/Identifiers/InvoiceNumber",
            "type": "str",
            "op": "regex",
            "value": "^INV-\\d{6}$",
            "alias": "invoice_number"
          }
        ]
      }
    }
  ],
  "notifications": {
    "dry_run": true,
    "recipients": []
  }
}
