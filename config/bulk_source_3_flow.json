{
  "directories": {
    "source_dirs": [
      "runtime/bulk_xml_test/source_3"
    ],
    "archive_dir": "runtime/bulk_xml_test/flow_3/archive",
    "staging_dir": "runtime/bulk_xml_test/flow_3/staging",
    "output_root": "runtime/bulk_xml_test/flow_3/output",
    "quarantine_dir": "runtime/bulk_xml_test/flow_3/quarantine",
    "sqlite_path": "runtime/bulk_xml_test/flow_3/integration_run.sqlite3",
    "lock_file": "runtime/bulk_xml_test/flow_3/integration.lock"
  },
  "runtime": {
    "file_stability_seconds": 0,
    "archive_retention_days": 10,
    "no_overlap": true
  },
  "rules": [
    {
      "rule_id": "source_3_invoice",
      "description": "Source 3 normal invoice documents from TLO3 in OCEANIA routing.",
      "target_path_template": "source_3/oceania_invoices/{yyyy}/{mm}/{invoice_number}.xml",
      "conditions": {
        "all": [
          {
            "xpath": "/Envelope/Header/Sender/CompanyCode",
            "type": "str",
            "transform": "upper",
            "op": "eq",
            "value": "TLO3"
          },
          {
            "xpath": "/Envelope/Body/Documents/Document/Metadata/SourceDirectory",
            "type": "str",
            "op": "eq",
            "value": "source_3"
          },
          {
            "xpath": "/Envelope/Body/Documents/Document/Routing/Region",
            "type": "str",
            "transform": "upper",
            "op": "eq",
            "value": "OCEANIA"
          },
          {
            "xpath": "/Envelope/Body/Documents/Document/Metadata/DocumentType",
            "type": "str",
            "transform": "upper",
            "op": "eq",
            "value": "INVOICE"
          },
          {
            "xpath": "/Envelope/Body/Documents/Document/Identifiers/InvoiceNumber",
            "type": "str",
            "op": "regex",
            "value": "^INV-\\d{6}$",
            "alias": "invoice_number"
          }
        ]
      }
    },
    {
      "rule_id": "source_3_credit_note",
      "description": "Source 3 credit note documents from TLO3 in OCEANIA routing.",
      "target_path_template": "source_3/oceania_credit_notes/{yyyy}/{mm}/{invoice_number}.xml",
      "conditions": {
        "all": [
          {
            "xpath": "/Envelope/Header/Sender/CompanyCode",
            "type": "str",
            "transform": "upper",
            "op": "eq",
            "value": "TLO3"
          },
          {
            "xpath": "/Envelope/Body/Documents/Document/Metadata/SourceDirectory",
            "type": "str",
            "op": "eq",
            "value": "source_3"
          },
          {
            "xpath": "/Envelope/Body/Documents/Document/Routing/Region",
            "type": "str",
            "transform": "upper",
            "op": "eq",
            "value": "OCEANIA"
          },
          {
            "xpath": "/Envelope/Body/Documents/Document/Metadata/DocumentType",
            "type": "str",
            "transform": "upper",
            "op": "eq",
            "value": "CREDIT_NOTE"
          },
          {
            "xpath": "/Envelope/Body/Documents/Document/Identifiers/InvoiceNumber",
            "type": "str",
            "op": "regex",
            "value": "^INV-\\d{6}$",
            "alias": "invoice_number"
          }
        ]
      }
    }
  ],
  "notifications": {
    "dry_run": true,
    "recipients": []
  }
}
